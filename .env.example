# =========================================================================
# RECOVERYHUB DASHBOARD SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill out with your actual active credentials.
# =========================================================================

# --- Web Server settings ---
PORT=8001

# --- Metadata DB (MongoDB) configuration ---
# (Note: For local docker-compose, this is auto-routed to the local Mongo container)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=recoveryhub_dashboard

# --- Target SQL Database (Azure SQL) configuration ---
# The primary database where emergency fire runs, claims, and invoices live.
AZURE_SQL_HOST=your-azure-sql-server.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DB=RecoveryHubClaims
AZURE_SQL_USER=dashboard_reader_user
AZURE_SQL_PASSWORD=your_secure_azure_sql_password
AZURE_SQL_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Entra ID Authentication configuration ---
# Microsoft OAuth 2.0 Credentials (tenant-specific streamlineas.com setup)
# AZURE_CLIENT_ID is the backend service principal (used for OIDC deploy auth
# and backend API access). VITE_AZURE_CLIENT_ID is the SPA app registration
# used for user-interactive MSAL login in the browser. These are DIFFERENT app
# registrations — do not reuse the same client ID for both.
#
# IMPORTANT: VITE_AZURE_CLIENT_ID (frontend) and AZURE_CLIENT_ID (backend) must
# reference the SAME SPA app registration client ID. The backend validates the
# JWT audience (aud claim) of the idToken sent by the frontend against
# AZURE_CLIENT_ID, and the frontend's MSAL acquires that idToken with
# aud=VITE_AZURE_CLIENT_ID. In production both come from the AZURE_SPA_CLIENT_ID
# GitHub secret (see .github/workflows/deploy.yml and terraform/variables.tf).
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=d7d4d4d0-5460-4655-ab6d-a9aaac38b578
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
DEV_AUTH_BYPASS=false
VITE_DEV_AUTH_BYPASS=false

# --- CORS / Frontend Origin ---
# Origin (scheme + host, no trailing path) of the frontend that the backend
# allows via CORS. Defaults to the local dev origin. In production this MUST be
# set to the deployed frontend FQDN (e.g. https://rh-dashboard-web.<env>.<region>.azurecontainerapps.io).
# Provided to the backend via the FRONTEND_URL GitHub secret / TF_VAR_frontend_url.
# Must be a bare origin: no path, no trailing slash (validated at startup).
FRONTEND_URL=http://localhost:3000

# --- JWKS Fetch Resilience (optional) ---
# The backend fetches Microsoft's public signing keys on first token
# verification. These control retry behavior for high-latency or cold-start
# scenarios. Defaults work for most Azure Container Apps environments.
#JWKS_FETCH_MAX_ATTEMPTS=2
#JWKS_FETCH_TIMEOUT=15
#JWKS_FETCH_BACKOFF=1

# --- Azure Billing Integration ---
# Dedicated service principal for programmatic billing API access.
# This is SEPARATE from the AZURE_CLIENT_ID used for user-interactive login.
# See docs/supporting/02-azure-auth-setup-guide.md for setup instructions.
AZURE_BILLING_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_BILLING_CLIENT_SECRET=your_billing_service_principal_client_secret

# Azure subscription and billing account identifiers
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_BILLING_ACCOUNT_ID=12345678
# Billing account agreement type: EA (Enterprise Agreement), MCA (Microsoft Customer Agreement),
# or MOSP (Microsoft Online Services Program / Web Direct / Pay-as-you-go)
AZURE_BILLING_ACCOUNT_TYPE=MOSP

# Optional: Management group ID for multi-subscription cost queries
# Leave blank if querying a single subscription only
AZURE_MANAGEMENT_GROUP_ID=

# --- AI / Cost Analysis ---
# The AI Cost Analyst needs a chat model + an embeddings model. Two providers
# are supported; pick ONE:
#
# Option A — Azure OpenAI (Foundry)  [recommended for Azure-hosted orgs]
# Set AZURE_OPENAI_ENDPOINT to enable this path. When set, OPENAI_CHAT_MODEL and
# OPENAI_EMBEDDING_MODEL below are treated as Azure *deployment* names, and
# OPENAI_API_KEY is ignored.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2024-10-21
#
# Option B — OpenAI.com (leave AZURE_OPENAI_ENDPOINT blank to use this)
OPENAI_API_KEY=sk-...
#
# Model / deployment names (for Azure these are the deployment names you created):
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Billing Sync Scheduler Configuration ---
# Set to 'false' to disable the background billing sync scheduler entirely.
# Useful for local development when you don't want live Azure API calls.
BILLING_SYNC_ENABLED=true
# UTC hour (0-23) at which the daily cost sync runs (default: 2 AM UTC)
BILLING_DAILY_SYNC_HOUR=2
# Number of months of historical data to backfill on first startup (max: 12)
BILLING_HISTORY_MONTHS=12

# --- AI Analytics Worker (Phase 9) ---
# Set to 'true' to enable the background AI Analytics Worker that builds
# projections from RecoveryHub_AI Mongo into the dashboard-owned Mongo.
# The worker reads change streams from the operational AI cluster and writes
# aggregated analytics projections to ai_invoice_analytics collection.
AI_ANALYTICS_WORKER_ENABLED=false
# Worker version string (for observability and schema migration tracking)
AI_ANALYTICS_WORKER_VERSION=0.1.0
# Projection schema version (must be >= 1, incremented on breaking changes)
AI_ANALYTICS_WORKER_PROJECTION_SCHEMA_VERSION=1
# When true, AI analytics dashboard endpoints read from the worker's
# ai_invoice_analytics projection instead of querying the operational
# RecoveryHub_AI Mongo directly. Set this to true only after the worker
# has populated the projection collection. Default false for safe rollout.
AI_ANALYTICS_USE_PROJECTION=false

# --- RecoveryHUB AI / Department Onboarding ---
# Production AI fee/resource configuration database.
RECOVERYHUB_AI_MONGODB_DB_NAME=AI_FEE_CALC_MULTI_AGENT_PROD
